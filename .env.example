# DevCore Monitor — copie para .env.local (dev) ou .env.production (servidor) e preencha.
# Nunca coloque valores reais no Git.

# Auth.js: segredo próprio do painel (openssl rand -base64 32) e URL pública.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Usuários da equipe com acesso ao painel: "email:hash[:Nome]", separados por vírgula.
# Gere cada entrada com: npm run hash-password -- email@multicortex.com.br "Nome"
DEVCORE_USERS=

# Opcional: cadastro de VMs externo (substitui config/devcore-vms.json sem rebuild).
DEVCORE_VMS_FILE=

# Um token por VM (o nome vem do campo tokenEnv do cadastro). Só no servidor.
DEVCORE_METRICS_TOKEN_DEVCORE_DEMO_01=

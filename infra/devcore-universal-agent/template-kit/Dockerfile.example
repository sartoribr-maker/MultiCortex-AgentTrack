# MultiCortex DevCore Monitor — acrescentar ao FINAL do Dockerfile do template.
# Não substitui a imagem base nem o comando que inicia o modelo.

# 1) Dependências do agente (python3 3.6+ e tcpdump). Use o bloco da sua base:
# openSUSE (imagem multicortex/multicortex-2.0.6-work):
RUN zypper -n in --no-recommends python3 tcpdump ca-certificates && zypper clean -a
# Debian/Ubuntu:
# RUN apt-get update && apt-get install -y --no-install-recommends python3 tcpdump ca-certificates && rm -rf /var/lib/apt/lists/*

# 2) Código do agente (somente código; nenhuma credencial entra na imagem).
COPY devcore-universal-agent-template-v3/ /tmp/devcore-agent-kit/
RUN python3 /tmp/devcore-agent-kit/install.py --install-dir /opt/multicortex/devcore-universal-agent \
    && rm -rf /tmp/devcore-agent-kit

# 3) Endereço do Monitor (não é segredo).
ENV MULTICORTEX_MONITOR_URL=https://devcore.multicortex.com.br/agenttrack

# 4) Iniciar o agente junto com o template, sem trocar o comando original.
#    O agente sobe em segundo plano e em seguida o comando original roda normalmente.
#    Troque "/entrypoint.sh" pelo ENTRYPOINT real da imagem base, se for outro
#    (conferir com: docker inspect <imagem> --format '{{json .Config.Entrypoint}} {{json .Config.Cmd}}').
#    Se a imagem base tiver CMD, repita-o aqui: trocar ENTRYPOINT apaga o CMD herdado.
ENTRYPOINT ["/opt/multicortex/devcore-universal-agent/entrypoint-agent.sh", "/entrypoint.sh"]
